# Base de données SQLite (volume persistant en production)
DATABASE_URL=./data/ligue.db
MIGRATIONS_DIR=./drizzle
DATABASE_BUSY_TIMEOUT_MS=5000

# Origine publique exacte de l'application (sans barre oblique finale)
ORIGIN=https://ligue.example.com
APP_ENV=production

# Secret Better Auth : 32 caractères minimum, généré une seule fois
# openssl rand -base64 48
BETTER_AUTH_SECRET=

# Sessions et protection contre les tentatives de connexion
SESSION_DAYS=30
INVITE_DAYS=7
LOGIN_WINDOW_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
PASSWORD_MIN_LENGTH=10

# Premier administrateur, créé au démarrage s'il n'existe pas
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notifications push (obligatoires pour activer le push)
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Courriel (obligatoire pour activer les courriels)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File de notifications
NOTIFICATION_TICK_MS=60000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_CLAIM_TIMEOUT_MS=600000

# Journalisation : debug, info, warn, error
LOG_LEVEL=info
