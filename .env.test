# Environment used by the automated test suite.
#
# Vitest runs Vite in test mode, and SvelteKit bakes `$app/env` from the mode
# files before any test runs. These fixture values therefore live here, once,
# so the gate behaves identically on a clean machine, in a worktree and in CI.
# Never put deployment values or secrets in this file.
ORIGIN=http://localhost:5173
BETTER_AUTH_SECRET=test-secret-fixture-with-at-least-32-characters
